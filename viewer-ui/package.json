{
  "name": "nightcrow-viewer-ui",
  "private": true,
  "version": "0.1.19",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:scripts && tsc -b && vite build",
    "preview": "vite preview",
    "prelint": "node scripts/check-deps.ts",
    "lint": "oxlint .",
    "pretest": "node scripts/check-deps.ts",
    "pretest:visual": "node scripts/check-deps.ts",
    "test:visual": "node ../scripts/run-visual.ts",
    "prebuild": "node scripts/check-deps.ts",
    "test": "vitest run",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "entities": "^8.1.0",
    "highlight.js": "^11.12.0",
    "parse5": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "oxlint": "1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
