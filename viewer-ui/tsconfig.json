{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // For `api.fixture.json`, the server-generated wire fixture that
    // `api.contract.test.ts` type-checks these interfaces against.
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "api.fixture.json"]
}
